#!/bin/bash
# 指定したホスト上の、指定したセッション名の tmux セッションに SSH 経由でアタッチする。
# ghost-initialize が生成した ghost 専用鍵（~/.ssh/id_ed25519_ghost）を明示的に使う。
set -euo pipefail

BASENAME="$(basename "$0")"
KEY_PATH="$HOME/.ssh/id_ed25519_ghost"

usage() {
  {
    echo "$BASENAME: $1"
    echo "usage: $BASENAME <host> <session_name>"
    echo "example: $BASENAME dev-yamada work"
    echo
    awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"
  } >&2
}

if [ "$#" -ne 2 ]; then
  usage "Wrong number of arguments"
  exit 1
fi

host="$1"
session_name="$2"

echo "joining: ssh -i $KEY_PATH -t $host tmux attach -t $session_name" >&2
exec ssh -i "$KEY_PATH" -t "$host" "tmux attach -t $session_name"
