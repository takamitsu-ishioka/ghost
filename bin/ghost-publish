#!/bin/bash
# 指定したセッション名で Claude Code を実行する tmux セッションを作成する。
# 既に同名セッションが存在する場合はそれにアタッチする（tmux new-session -A）。
# "--" の後ろに書いた引数はそのまま claude へスルーパスする。
set -euo pipefail

BASENAME="$(basename "$0")"

usage() {
  {
    echo "$BASENAME: $1"
    echo "usage: $BASENAME <session_name> [-- <claude_args>...]"
    echo "example: $BASENAME work"
    echo "example: $BASENAME work -- --dangerously-skip-permissions"
    echo
    awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"
  } >&2
}

if [ "$#" -lt 1 ]; then
  usage "Wrong number of arguments"
  exit 1
fi

session_name="$1"
shift

claude_args=()
if [ "$#" -gt 0 ]; then
  if [ "$1" != "--" ]; then
    usage "Expected -- before claude options"
    exit 1
  fi
  shift
  claude_args=("$@")
fi

echo "publishing: tmux new-session -A -s $session_name claude ${claude_args[*]}" >&2
exec tmux new-session -A -s "$session_name" claude "${claude_args[@]}"
